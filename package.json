{
  "name": "@itmr.dev/bump",
  "type": "module",
  "version": "2.1.0",
  "description": "a small cli tool to publish new code versions by creating git tags and updating package.json",
  "repository": "github:itmr-dev/bump",
  "homepage": "https://github.com/itmr-dev/bump#readme",
  "bugs": {
    "url": "https://github.com/itmr-dev/bump/issues"
  },
  "keywords": [
    "bump",
    "cli",
    "git",
    "publish",
    "version"
  ],
  "main": "./lib/index.js",
  "bin": "./lib/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node ./lib/index.js",
    "test": "tsc && node --test 'test/*.test.js'",
    "prepublishOnly": "npm test && npm run check-lib",
    "check-lib": "test -z \"$(git status --porcelain -- lib)\" || { echo 'lib/ differs from a fresh build of src/: commit lib/ first'; exit 1; }"
  },
  "author": "Marc Rufeis",
  "license": "ISC",
  "dependencies": {
    "chalk": "^6.0.1",
    "execa": "^10.2.0",
    "inquirer": "^14.2.3",
    "nanospinner": "^1.2.2",
    "package-json": "^10.0.1",
    "semver": "^7.8.5",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "directories": {
    "lib": "lib"
  },
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  }
}
